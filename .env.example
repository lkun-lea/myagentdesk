MAD_DATABASE_URL=postgresql://mad:mad_dev@127.0.0.1:55438/myagentdesk
MAD_ORIGIN=http://127.0.0.1:4178
# Set all three to enable accounts. Use a separate Supabase project and its publishable key.
# MAD_SUPABASE_URL=https://your-test-project.supabase.co
# MAD_SUPABASE_PUBLISHABLE_KEY=
# MAD_SESSION_KEY=
# Optional model configuration file, read by the server. Supports ATLAS_API_KEY, ATLAS_BASE_URL, ATLAS_MODEL.
# MAD_MODEL_ENV_FILE=E:/Learn_Project/desk-companion/.env
# MAD_NODE_BINARY=node
# App-managed project artifact directories (not arbitrary code execution).
# MAD_RESOURCE_ROOT=E:/MyAgentDeskData/artifacts
# Set to 0 to use only the separate `python -m server.resume_worker` process.
MAD_RESUME_WORKER=1
